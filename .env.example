# reranker-service ENV-Vorlage
# Pfad fuer Produktiv-Deploy: /etc/reranker-service/env (chmod 600)

# Image-Tag (vom GHCR-Push)
IMAGE_TAG=v0.1

# Listen — Default ist 0.0.0.0 (alle Interfaces). Auf NUC mit Tailscale
# auf die Tailscale-IP einschraenken, damit der Service NUR ueber das
# Tailnet erreichbar ist:
#   RERANKER_BIND=100.102.132.11
RERANKER_BIND=100.102.132.11

# Device — cpu | cuda | cuda:0
RERANKER_DEVICE=cpu

# Default-Modell (wenn Request kein "model"-Feld setzt)
RERANKER_DEFAULT_MODEL=BAAI/bge-reranker-v2-m3

# Preload beim Startup — kommagetrennt
# audit_designer + workshop nutzen bge, flowinvoice nutzt ms-marco
RERANKER_PRELOAD_MODELS=BAAI/bge-reranker-v2-m3,cross-encoder/ms-marco-MiniLM-L-6-v2

# API-Key fuer Service-Auth. Empfohlen: vom llm-router gesetzt + im
# Spoke-Header (auth_value) konfiguriert. Leer = offen im Tailnet.
RERANKER_API_KEY=CHANGEME-vom-vault

# Logging-Verbose? (nicht implementiert, Default INFO)
# LOG_LEVEL=INFO
